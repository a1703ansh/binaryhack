# EarnWise Server — local dev environment
# Copy to .env and fill in values.

# PostgreSQL (docker compose service `db` on host port 5433)
DATABASE_URL="postgresql://earnwise:earnwise_dev@localhost:5433/earnwise?schema=public"

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Express port for the API
PORT=4000

# Frontend origin allowed by CORS (vite dev server)
CLIENT_ORIGIN="http://localhost:5173"

# GroqCloud free-tier API key for the AI Copilot (optional — falls back to rule-based replies)
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"